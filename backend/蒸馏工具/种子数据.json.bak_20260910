{"说明": "「银龄伴」训练种子数据 V5：十类 + 否定/反差句（含错题回炉数据）", "数据": [{"text": "我天天唱戏，敞亮着呢", "label": "开朗型"}, {"text": "看看报纸，挺规律的，挺好", "label": "平静型"}, {"text": "没盼头，眼眶老湿，懒得动", "label": "低落型"}, {"text": "一天说不上三句话，混一天是一天", "label": "低落型"}, {"text": "我天天遛弯，开心着呢", "label": "开朗型"}, {"text": "看着别人一家团圆，我心里压着块石头，没意思", "label": "低落型"}, {"text": "老伙计大半年回来看我一趟，平时说不上话", "label": "孤独型"}, {"text": "老觉得心口心慌，怕是大病的兆头，担心得睡不着", "label": "焦虑型"}, {"text": "跟舞友们打牌去，日子过得可美了", "label": "开朗型"}, {"text": "老伴一年回来看我一趟，平时没人说话", "label": "孤独型"}, {"text": "血糖老是降不下来，我翻来覆去想，不放心", "label": "焦虑型"}, {"text": "年轻时候的事都翻篇了，现在就想平安过日子", "label": "平静型"}, {"text": "电视广告广告的，我等开演等得心烦。", "label": "急躁型"}, {"text": "活着就是累赘，吃什么都一个味", "label": "低落型"}, {"text": "儿子忙，我就我一个人惯了，就是没人说话", "label": "孤独型"}, {"text": "这日子过得过一天算一天，吃什么都一个味", "label": "低落型"}, {"text": "孙子半年回来看我一趟，平时一天说不上一句话", "label": "孤独型"}, {"text": "好几个月见不着孙女，没着没落的", "label": "孤独型"}, {"text": "老觉得后背不舒服，怕是大病的兆头，提心吊胆", "label": "焦虑型"}, {"text": "老姐妹在北方工作，大半年才回来一次", "label": "孤独型"}, {"text": "省吃俭用，家里啥都不舍得扔", "label": "勤俭型"}, {"text": "孙子都忙各自的日子，说不上话", "label": "孤独型"}, {"text": "女儿半年回来看我一趟，平时没人说话", "label": "孤独型"}, {"text": "一年到头见不着孩子，冷清得很", "label": "孤独型"}, {"text": "到点睡到点起，日子还凑合", "label": "平静型"}, {"text": "孙子大半年回来看我一趟，平时一天说不上一句话", "label": "孤独型"}, {"text": "织毛衣，一天就过去了，安稳就好", "label": "平静型"}, {"text": "老觉得腿难受，怕是大病的兆头，怕出事", "label": "焦虑型"}, {"text": "身体嘛，小毛病有，大毛病没有，不好不坏", "label": "平静型"}, {"text": "早上跟票友们一起练字，可带劲了", "label": "开朗型"}, {"text": "大半年能见闺女一面，想得慌", "label": "孤独型"}, {"text": "没什么意思，吃什么都一个味，不想接电话", "label": "低落型"}, {"text": "晒晒太阳，不好不坏的", "label": "平静型"}, {"text": "儿子总夸我中气足，我听了心里开心", "label": "开朗型"}, {"text": "孩子半年回来看我一趟，平时说不上话", "label": "孤独型"}, {"text": "旧衣服，边说边想起以前的事就掉眼泪", "label": "怀旧型"}, {"text": "混一天是一天，没胃口，懒得做", "label": "低落型"}, {"text": "这日子过得没盼头，没胃口", "label": "低落型"}, {"text": "遛遛弯，挺规律的，挺好", "label": "平静型"}, {"text": "我这人舍不得花钱，能省则省", "label": "勤俭型"}, {"text": "床我都懒得铺了，反正就我一个人睡", "label": "低落型"}, {"text": "懒得动，饭也没胃口", "label": "低落型"}, {"text": "今年外孙女带我出去旅游，拍了好些照片，敞亮", "label": "开朗型"}, {"text": "过一天算一天，睡也白睡，不想接电话", "label": "低落型"}, {"text": "体检结果还没出来，我这心里提心吊胆", "label": "焦虑型"}, {"text": "我这人没耐心，见不得拖拖拉拉", "label": "急躁型"}, {"text": "整理老照片习惯了，老样子，儿女自有儿孙福", "label": "平静型"}, {"text": "睡不着加上不放心，觉都睡不好", "label": "焦虑型"}, {"text": "老毛病老是降不下来，我老想着，担心得睡不着", "label": "焦虑型"}, {"text": "打个盹，一天就过去了，没什么特别的", "label": "平静型"}, {"text": "不想说话，饭也吃什么都一个味", "label": "低落型"}, {"text": "胃难受了两天了，要不要去医院看看，愁得慌", "label": "焦虑型"}, {"text": "没盼头，心里压着块石头，懒得做", "label": "低落型"}, {"text": "没什么意思，睡也白睡，不想见人", "label": "低落型"}, {"text": "老觉得腰难受，怕是大病的兆头，不放心", "label": "焦虑型"}, {"text": "睡不好加上心里没底，觉都睡不好", "label": "焦虑型"}, {"text": "一个人住惯了，也还好，还行吧", "label": "平静型"}, {"text": "中午跟老邻居下棋赢了两盘，高兴", "label": "开朗型"}, {"text": "精神头足，每天敞亮", "label": "开朗型"}, {"text": "闺女在北方工作，一年半载才回来一次", "label": "孤独型"}, {"text": "今天天气好，出来跳广场舞，心情跟着也得劲", "label": "开朗型"}, {"text": "心里跟压了块石头似的，喘不过气", "label": "低落型"}, {"text": "都还凑合，没什么事", "label": "平静型"}, {"text": "孩子在上海工作，好几个月才回来一次", "label": "孤独型"}, {"text": "外孙可黏我了，天天视频，我得劲", "label": "开朗型"}, {"text": "作息规律，腿脚还行慢慢走，说得过去", "label": "平静型"}, {"text": "早上跟老姐妹们一起跳广场舞，可带劲了", "label": "开朗型"}, {"text": "晚上吃不下，怕出事", "label": "焦虑型"}, {"text": "平时就煲个汤，不好不坏的", "label": "平静型"}, {"text": "总觉得自己这病那病的，越想越怕，睡不好", "label": "焦虑型"}, {"text": "老觉得胸口心慌，怕是大病的兆头，七上八下的", "label": "焦虑型"}, {"text": "性子急，隔着电话都能听出我急", "label": "急躁型"}, {"text": "早上跟老伙计们一起扭秧歌，可带劲了", "label": "开朗型"}, {"text": "老姐妹忙，我自己过惯了，就是连个说话的人都没有", "label": "孤独型"}, {"text": "唠叨得很，觉睡到一半还惦记着嘱咐几句", "label": "唠叨型"}, {"text": "吃也吃不下，总觉得胃里不对劲", "label": "焦虑型"}, {"text": "一有点小毛病就想到最坏的结果，控制不住", "label": "焦虑型"}, {"text": "楼里组织春游，我第一个报了名还帮大家订了车", "label": "开朗型"}, {"text": "中午跟晨练的伙伴下棋赢了两盘，开心", "label": "开朗型"}, {"text": "过一天算一天，吃什么都一个味，不想见人", "label": "低落型"}, {"text": "闺女考上大学了，给我敞亮得睡不着", "label": "开朗型"}, {"text": "晚上睡不着，担心得睡不着", "label": "焦虑型"}, {"text": "没盼头，睡也白睡，懒得出门", "label": "低落型"}, {"text": "老伙计好几个月回来看我一趟，平时没人说话", "label": "孤独型"}, {"text": "衣服够穿，饭够吃，没啥愁的", "label": "平静型"}, {"text": "浇浇花，没什么特别的", "label": "平静型"}, {"text": "胸口难受了两天了，要不要去医院看看，心里没底", "label": "焦虑型"}, {"text": "我腿脚利索，高兴，啥毛病没有", "label": "开朗型"}, {"text": "老觉得头没胃口，怕是大病的兆头，怕出事", "label": "焦虑型"}, {"text": "白开水似的，吃什么都一个味，懒得动", "label": "低落型"}, {"text": "大半年见不着老姐妹，怪想他们的", "label": "孤独型"}, {"text": "病老是降不下来，我老想着，提心吊胆", "label": "焦虑型"}, {"text": "早上跟一群老伙伴们一起打太极，可带劲了", "label": "开朗型"}, {"text": "睡过去算了，省得给孩子添麻烦", "label": "低落型"}, {"text": "楼里钓友常来串门，热闹，开心", "label": "开朗型"}, {"text": "我天天扭秧歌，痛快着呢", "label": "开朗型"}, {"text": "屋里乱了也没心思收拾，不想见人", "label": "低落型"}, {"text": "孩子们忙，我理解，电话常联系，平平淡淡才是真", "label": "平静型"}, {"text": "看着别人一家团圆，我没胃口，混一天是一天", "label": "低落型"}, {"text": "大半年见不着孩子，冷清得很", "label": "孤独型"}, {"text": "老觉得心口难受，怕是大病的兆头，心里没底", "label": "焦虑型"}, {"text": "打麻将赢了点小钱，请老伙计们吃了冰棍", "label": "开朗型"}, {"text": "遛遛弯，就平常过日子", "label": "平静型"}, {"text": "家里就剩我，连个说话的人都没有，日子长了冷清得很", "label": "孤独型"}, {"text": "老手艺，人老了就爱往回看", "label": "怀旧型"}, {"text": "混一天是一天，眼眶老湿，不想接电话", "label": "低落型"}, {"text": "以前那些爱好，现在懒得做，没意思", "label": "低落型"}, {"text": "白天还好，一到晚上没着没落的", "label": "孤独型"}, {"text": "一年到头见不着孩子，静得慌", "label": "孤独型"}, {"text": "孙女都忙各自的日子，连个说话的人都没有", "label": "孤独型"}, {"text": "现在的年轻人不懂，老歌在我们心里分量重", "label": "怀旧型"}, {"text": "常跟人念叨当年的书信，那时候的日子", "label": "怀旧型"}, {"text": "平时就整理老照片，不争不抢的", "label": "平静型"}, {"text": "楼里钓友常来串门，热闹，乐呵", "label": "开朗型"}, {"text": "不想动，也不想知道外面的事，没什么意思", "label": "低落型"}, {"text": "急性子改不掉，一不顺心就挂脸", "label": "急躁型"}, {"text": "看着别人一家团圆，我睡也白睡，混一天是一天", "label": "低落型"}, {"text": "没盼头，眼眶老湿，不想说话", "label": "低落型"}, {"text": "一个人住着，没人管我，日子长了夜里更冷清", "label": "孤独型"}, {"text": "阳台上花都让我养死了好几盆，我也没心思重种", "label": "低落型"}, {"text": "血糖老是降不下来，我天天量，心里没底", "label": "焦虑型"}, {"text": "午觉补一补，天冷关节有点僵，一般般", "label": "平静型"}, {"text": "血糖老是降不下来，我天天惦记，提心吊胆", "label": "焦虑型"}, {"text": "擦擦桌子，知足常乐", "label": "平静型"}, {"text": "孙子好几个月回来看我一趟，平时没人说话", "label": "孤独型"}, {"text": "今天天气好，出来唱歌，心情跟着也欢喜", "label": "开朗型"}, {"text": "我一个人过惯了，就是没人说说话", "label": "孤独型"}, {"text": "心脏老是降不下来，我一天量好几遍，不放心", "label": "焦虑型"}, {"text": "身子骨结实，每天开心", "label": "开朗型"}, {"text": "凑合活着，眼眶老湿，懒得做", "label": "低落型"}, {"text": "孩子忙，我一个人过惯了，就是没人管我", "label": "孤独型"}, {"text": "打个盹，平平淡淡才是真", "label": "平静型"}, {"text": "爆脾气，一打电话就催", "label": "急躁型"}, {"text": "半年见不着女儿，心里空落落的", "label": "孤独型"}, {"text": "跟钓友们钓鱼去，日子过得可美了", "label": "开朗型"}, {"text": "您别嫌絮叨，我这是为你们好", "label": "唠叨型"}, {"text": "去医院拿药，还过得去", "label": "平静型"}, {"text": "中午跟钓友下棋赢了两盘，得劲", "label": "开朗型"}, {"text": "精神头足，每天乐呵", "label": "开朗型"}, {"text": "好几个月见不着老姐妹，怪想他们的", "label": "孤独型"}, {"text": "这些旧东西比新的金贵，它们记得我这一辈子。", "label": "怀旧型"}, {"text": "爱操心，每句话都要说两遍才放心", "label": "唠叨型"}, {"text": "身体嘛，腿脚还行慢慢走，挺好", "label": "平静型"}, {"text": "自己过，一天说不上一句话，日子长了想得慌", "label": "孤独型"}, {"text": "老觉得头难受，怕是大病的兆头，越想越怕", "label": "焦虑型"}, {"text": "闺女在广州工作，半年才回来一次", "label": "孤独型"}, {"text": "去医院拿药，没什么大起大落", "label": "平静型"}, {"text": "饭量小了点但正常，知足常乐", "label": "平静型"}, {"text": "屋里太静了，我总开着电视听个响，没着没落的", "label": "孤独型"}, {"text": "遛遛弯，一天就过去了，不好不坏的", "label": "平静型"}, {"text": "医生说老毛病，不用怕，可我还是不敢停一天药", "label": "焦虑型"}, {"text": "我天天唱歌，敞亮着呢", "label": "开朗型"}, {"text": "楼里一群老伙伴常来串门，热闹，得劲", "label": "开朗型"}, {"text": "一个人过，说不上话，日子长了心里空落落的", "label": "孤独型"}, {"text": "我这舍不得穿，闲不下来，怕闲着", "label": "勤俭型"}, {"text": "家里就剩我，没人陪我，日子长了想得慌", "label": "孤独型"}, {"text": "心脏老是降不下来，我净琢磨，不放心", "label": "焦虑型"}, {"text": "病老是降不下来，我天天惦记，担心得睡不着", "label": "焦虑型"}, {"text": "说是没什么大事，可我这心里老放不下", "label": "焦虑型"}, {"text": "孩子一年回来看我一趟，平时连个说话的人都没有", "label": "孤独型"}, {"text": "血糖一波动我就紧张，翻来覆去想好几遍", "label": "焦虑型"}, {"text": "活着就是碍事，没胃口", "label": "低落型"}, {"text": "没劲，睡也白睡，不想见人", "label": "低落型"}, {"text": "孩子们都孝顺，隔三差五来看我，我心里美滋滋", "label": "开朗型"}, {"text": "没意思，眼眶老湿，懒得动", "label": "低落型"}, {"text": "到点睡到点起，日子还过得去", "label": "平静型"}, {"text": "我天天养鸟，得劲着呢", "label": "开朗型"}, {"text": "老觉得胃头晕，怕是大病的兆头，不放心", "label": "焦虑型"}, {"text": "打个盹，挺规律的，不好不坏", "label": "平静型"}, {"text": "儿子在南方工作，大半年才回来一次", "label": "孤独型"}, {"text": "儿子考上大学了，给我乐呵得睡不着", "label": "开朗型"}, {"text": "俭省了一辈子，钱要花在刀刃上", "label": "勤俭型"}, {"text": "早上醒得早，躺着睁眼等天亮，混一天是一天", "label": "低落型"}, {"text": "睡眠一般岁数到了都这样，不争不抢的", "label": "平静型"}, {"text": "孩子们有自己的生活，日子正常过", "label": "平静型"}, {"text": "一个人吃饭没滋味，没着没落的", "label": "孤独型"}, {"text": "白天还好，一到晚上冷清得很", "label": "孤独型"}, {"text": "家里人总劝我改，可我这急的喔改不了", "label": "急躁型"}, {"text": "夜里睡不着，醒了就开始胡思乱想，愁得慌", "label": "焦虑型"}, {"text": "外孙考上大学了，给我高兴得睡不着", "label": "开朗型"}, {"text": "社区活动我都参加，还得了奖呢，痛快", "label": "开朗型"}, {"text": "压不住火，事情就得当天办完", "label": "急躁型"}, {"text": "我唱戏是一把好手，上礼拜还露了一手", "label": "开朗型"}, {"text": "他们说我想不开，我只是不想折腾了", "label": "低落型"}, {"text": "我精神头足，开心，啥毛病没有", "label": "开朗型"}, {"text": "儿子忙，我屋里就我惯了，就是说不上话", "label": "孤独型"}, {"text": "社区活动我都参加，队伍里数我领得好，高兴", "label": "开朗型"}, {"text": "爱着急，看不得磨磨蹭蹭", "label": "急躁型"}, {"text": "孩子们忙，我理解，电话常联系，没什么特别的", "label": "平静型"}, {"text": "老两口搭伙过日子，安安稳稳的", "label": "平静型"}, {"text": "夜里睡不好，醒了就开始胡思乱想，怕出事", "label": "焦虑型"}, {"text": "一个人住惯了，也还好，就那样", "label": "平静型"}, {"text": "一年半载见不着老伙计，心里空落落的", "label": "孤独型"}, {"text": "每天固定，日子还行吧", "label": "平静型"}, {"text": "没劲，吃什么都一个味，提不起劲", "label": "低落型"}, {"text": "中午跟老邻居下棋赢了两盘，敞亮", "label": "开朗型"}, {"text": "今天天气好，出来跳广场舞，心情跟着也高兴", "label": "开朗型"}, {"text": "总觉得胃不舒服，怕出事", "label": "焦虑型"}, {"text": "看着别人一家团圆，我吃什么都一个味，凑合活着", "label": "低落型"}, {"text": "平时就买菜做饭，习惯就好了", "label": "平静型"}, {"text": "看着别人一家团圆，我夜里想哭，白开水似的", "label": "低落型"}, {"text": "精神头足，每天滋润", "label": "开朗型"}, {"text": "都没啥变化，没什么事", "label": "平静型"}, {"text": "跟老姐妹们唱戏去，日子过得可美了", "label": "开朗型"}, {"text": "儿子都忙各自的日子，一天说不上一句话", "label": "孤独型"}, {"text": "一个人住惯了，也还好，还不错", "label": "平静型"}, {"text": "没劲，吃什么都一个味，不想接电话", "label": "低落型"}, {"text": "今天天气好，出来打牌，心情跟着也滋润", "label": "开朗型"}, {"text": "老觉得后背没胃口，怕是大病的兆头，愁得慌", "label": "焦虑型"}, {"text": "活着就是不如没有我，睡也白睡", "label": "低落型"}, {"text": "孙女打电话也就几分钟，挂了电话想得慌", "label": "孤独型"}, {"text": "老姐妹打电话也就几分钟，挂了电话夜里更冷清", "label": "孤独型"}, {"text": "我吃嘛嘛香，痛快，啥毛病没有", "label": "开朗型"}, {"text": "夜里心慌，醒了就开始胡思乱想，七上八下的", "label": "焦虑型"}, {"text": "收拾屋子，一天就过去了，没什么特别的", "label": "平静型"}, {"text": "我这人脸色红润，每天不打太极就浑身不得劲", "label": "开朗型"}, {"text": 