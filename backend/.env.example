# ============================================================
# 「银龄伴」后端配置模板（角色2：郝英博）
# 使用方法：把本文件复制一份命名为 .env，按需修改
# 复制命令：copy .env.example .env
#
# 重要说明：文字理解统一走 DeepSeek 外部 API（不再使用本地大模型）
# ============================================================

# ---------------- 服务器 ----------------
# 监听地址（0.0.0.0 = 局域网其他设备也能访问，手机联调时用）
HOST=0.0.0.0
# 服务端口
PORT=8000

# ---------------- 文字理解：DeepSeek 外部 API（必填）----------------
# 申请地址：https://platform.deepseek.com （新用户有免费额度）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 大模型调用超时（秒）
LLM_TIMEOUT=60
# 对话历史最多携带轮数（控制 Token 消耗）
LLM_MAX_HISTORY=10

# ---------------- 语音识别：火山引擎（需自行开通）----------------
# 新控制台：填 VOLC_ASR_API_KEY（控制台 → API Key 管理）
# 旧控制台：填 VOLC_ASR_APP_ID + VOLC_ASR_ACCESS_TOKEN（控制台 → 应用）
VOLC_ASR_API_KEY=
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=

# ---------------- 向量化 Embedding（RAG 知识库用）----------------
# api：云端 Embedding | local：本地n-gram（零依赖，中文检索效果良好）
EMBEDDING_PROVIDER=auto
# 云端 Embedding（可选，如硅基流动 bge-m3，注册 https://siliconflow.cn 有免费额度）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---------------- 数据库 ----------------
# 默认 SQLite（零安装）；Docker 生产部署时改为 PostgreSQL：
# DATABASE_URL=postgresql://yinlingban:yinlingban123@postgres:5432/yinlingban
DATABASE_URL=

# ---------------- 缓存 ----------------
# 默认内存缓存；Docker 生产部署时启用 Redis：
# REDIS_URL=redis://redis:6379/0
REDIS_URL=

# ---------------- 向量数据库 ----------------
# 默认本地文件向量库（零安装，检索<10ms）；Docker 生产部署时启用 Milvus：
# MILVUS_URI=http://milvus:19530
MILVUS_URI=

# ---------------- 知识库 ----------------
# 知识分段大小（字）
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 检索返回条数
RAG_TOP_K=3
# 相似度阈值（本地稀疏向量分数普遍偏低，0.02 保守过滤即可；太高会漏检）
RAG_SCORE_THRESHOLD=0.02

# ---------------- 生活服务 ----------------
# 天气查询默认城市（老人没说城市时用）
DEFAULT_CITY=北京
WEATHER_TIMEOUT=8

# ---------------- 提醒服务 ----------------
# 提醒轮询间隔（秒）
REMINDER_CHECK_INTERVAL=20

# ---------------- 语音识别（可选，见上方火山引擎配置）----------------
# 推荐方案：前端用浏览器 Web Speech API 识别后传文字（零成本，无需配置）
# 云端方案：配置上方 VOLC_ASR_* 使用火山引擎录音文件识别极速版

# ---------------- 老人分型·蒸馏模型（将来训练好后填这里）----------------
# 现在分型用"规则打分"（零成本、可解释、能兜底）。
# 等您自己蒸馏训练好分类小模型后：
#   ① 模型放在 backend/distill/profile_model/ 目录（内含模型文件 + predict.py）
#   ② 取消下面一行的注释
#   ③ 重启服务 → 分型自动切到您的模型（加载失败自动退回规则，不中断）
# DISTILL_MODEL_PATH=distill/profile_model

# ---------------- 日志 ----------------
LOG_LEVEL=info
